rules_version = '2';

// DRAFT for review with the Firebase owner: see camera-ai/docs/firestore_security_review.md.
// Covers only the paths camera-ai reads or writes. Merge it into the project's rules.
//
// The edge node and the web admin's Flask backend use the Admin SDK (service account), which
// bypasses these rules. They govern the Flutter app and any browser code that reads Firestore.
//
// Assumptions to confirm:
// - Firebase Auth custom claim `role` is 'admin', 'teacher' or 'parent'.
// - classrooms/{classroomId} has `teacher_uids`, the teachers allowed to see that classroom.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    function teaches(classroomId) {
      return request.auth != null && request.auth.token.role == 'teacher'
        && request.auth.uid in get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacher_uids;
    }

    function sessionClassroom(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.classroom_id;
    }

    match /classrooms/{classroomId} {
      // Seat-grid calibration (UC01, UC10). Field allowlist mirrors config/remote_seat_grid.py.
      match /camera_configs/{cameraId} {
        allow read: if isAdmin() || teaches(classroomId);
        allow create, update: if (isAdmin() || teaches(classroomId))
          && request.resource.data.keys().hasOnly(['schema_version', 'config_version', 'camera_id',
                                                   'classroom_id', 'camera_angle_type', 'seats', 'pose'])
          && request.resource.data.classroom_id == classroomId
          && request.resource.data.camera_id == cameraId;
        allow delete: if isAdmin();
      }

      // Edge-node heartbeat (camera_ok, status). Written only by the edge node.
      match /edge_nodes/{cameraId} {
        allow read: if isAdmin() || teaches(classroomId);
      }
    }

    // Web admin sessions (camera-ai/docs/web_admin_integration.md). The web backend creates,
    // edits and deletes them; the edge node only reads `classroom_id` and `status`.
    // Client queries must filter on `classroom_id` so these rules can be checked.
    match /sessions/{sessionId} {
      allow read: if isAdmin() || teaches(resource.data.classroom_id);
      // UC04: the teacher starts a scheduled session and ends a live one. Nothing else changes.
      allow update: if teaches(resource.data.classroom_id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status == 'scheduled' && request.resource.data.status == 'live')
          || (resource.data.status == 'live' && request.resource.data.status == 'completed'));

      // Written only by the edge node. Parents never read per-seat records.
      match /engagement/{recordId} {
        allow read: if isAdmin() || teaches(sessionClassroom(sessionId));
      }

      // End-of-session summary per camera (UC03, UC11). Written only by the edge node.
      match /summaries/{cameraId} {
        allow read: if isAdmin() || teaches(sessionClassroom(sessionId));
      }

      // UC09: the teacher may only acknowledge or dismiss an alert.
      match /alerts/{alertId} {
        allow read: if isAdmin() || teaches(sessionClassroom(sessionId));
        allow update: if teaches(sessionClassroom(sessionId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['acknowledged', 'dismissed'];
      }
    }
    // Every path not matched above is denied.
  }
}
